classDiagram
%% Corrected and consistent class notation for Panolive domain

class CommunityMember {
  +Int UserId
  +String Name
  +String Email
  +String Location
  +Void UploadItem()
  +Suggestion[] ViewSuggestions()
  +RepairExpert[] ConnectRepairExpert()
  +EcoTip[] ViewEcoTips()
}

class Item {
  +Int ItemId
  +Int UserId
  +String Description
  +Image Image
  +String MaterialType
  +String IdentifyMaterial()
  +String CheckDisposability()
}

class Suggestion {
  +Int SuggestionId
  +Int ItemId
  +String Type
  +String Description
  +Void AcceptSuggestion()
  +Void RejectSuggestion()
  +String GetDetails()
  +Void FlagSuggestion()
}

class AIEngine {
  +Int EngineId
  +String AnalyzeItem(Item Item)
  +Suggestion[] GenerateSuggestions(Item Item)
}

class RepairExpert {
  +Int ExpertId
  +String Name
  +String Location
  +String[] Skills
  +Bool AcceptRequest()
  +Void RejectRequest()
  +Void UpdateAvailability()
}

class EcoTip {
  +Int TipId
  +String Content
  +Void AddTip()
  +Void UpdateTip()
  +Void DeleteTip()
}

class Administrator {
  +Int AdminId
  +String Username
  +String Password
  +Bool Login()
  +Void MonitorSystem()
  +Void ManageUsers()
  +Void UpdateTips()
}

CommunityMember "1" --> "many" Item : Uploads
Item "1" --> "many" Suggestion : Has
CommunityMember "1" --> "many" RepairExpert : ConnectsTo
CommunityMember "1" --> "many" EcoTip : Views
AIEngine "1" --> "many" Item : Analyzes
AIEngine "1" --> "many" Suggestion : Generates
Administrator "1" --> "many" CommunityMember : Manages
Administrator "1" --> "many" EcoTip : Manages
